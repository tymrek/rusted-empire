+    /// Next piece id to hand out. Ids are never reused, even after a piece dies
+    /// or while it is riding in a transport's cargo hold.
+    #[serde(default)]
+    pub next_id: usize,
 }
 
 impl Game {
@@ -49,6 +53,7 @@ impl Game {
             edit_cursor: Loc { r: 0, c: 0 },
             viewport_center: None,
             last_mouse_coord: None,
+            next_id: 1,
