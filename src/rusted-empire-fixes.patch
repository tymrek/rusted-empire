                 let starting_activity = if city.owner == Owner::Player {
                     city.default_orders.iter().find(|(p, _)| *p == city.prod).map(|(_, a)| *a)
@@ -1050,6 +1065,7 @@ impl Game {
         for msg in logs_to_add {
